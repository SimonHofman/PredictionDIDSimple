# =============================================================================
# Copy to .env at repo root:  cp .env.example .env
# Backend reads from process environment (load .env via your shell or IDE).
# Frontend uses VITE_* — copy frontend/.env.example to frontend/.env
# =============================================================================

# --- Database (matches docker-compose) ---
DATABASE_URL=postgres://prediction:prediction@localhost:5432/prediction?sslmode=disable

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- HTTP API ---
HTTP_PORT=8080

# --- Ethereum / Hardhat local node ---
ETH_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Deployed contracts (after deploy + seed on localhost)
# MARKET_FACTORY_ADDRESS=0x...
# MOCK_USDC_ADDRESS=0x...

# --- Auth (Phase 1) ---
JWT_SECRET=dev-secret-change-in-production
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:5173

# --- Indexer ---
INDEXER_START_BLOCK=0
INDEXER_POLL_SECONDS=5

# --- Phase 2 Oracle ---
ORACLE_ADAPTER_ADDRESS=0x...
DID_REGISTRY_ADDRESS=0x...
ORACLE_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ORACLE_COOLDOWN_MINUTES=1
ORACLE_TIMELOCK_SECONDS=60
ORACLE_POLL_SECONDS=10
MOCK_MATCHES_SECONDARY_PATH=data/mock_matches_secondary.json

# --- Phase 3 ---
# MARKET_FACTORY_V3_ADDRESS=0x...
# ORACLE_ADAPTER_V2_ADDRESS=0x...
GEO_BLOCK_ENABLED=true
BLOCKED_COUNTRIES=US,KP,IR,SY
RATE_LIMIT_PER_MINUTE=120
COMPLIANCE_REQUIRED=true
KYC_WEBHOOK_SECRET=
ETH_RPC_FALLBACK_URL=
APP_ENV=development

# --- Admin / VC ---
ADMIN_API_KEY=dev-admin-key
VC_ISSUER_KEY=dev-vc-issuer-key-change-me
ALERT_WEBHOOK_URL=

# --- Hardhat deploy (NEVER commit real mainnet keys) ---
# DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
